# =============================================================================
# LLM Configuration
# =============================================================================

# Backend: bedrock, lm_studio, or openai
LLM_BACKEND=bedrock

# Model selection (see config.py for available models)
# Bedrock options: llama-3.2-1b, llama-3.2-3b, llama-3.2-8b, claude-3-haiku, etc.
# LM Studio: Use model name from LM Studio (e.g., llama-3.2-3b-instruct)
# OpenAI: gpt-4o-mini, gpt-4o, etc.
LLM_MODEL=llama-3.2-3b

# Temperature (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.3

# =============================================================================
# Embedding Configuration
# =============================================================================

# Embedding backend: bedrock or openai
EMBEDDING_BACKEND=bedrock

# Embedding model
# Bedrock: titan-embed-text-v1, titan-embed-text-v2, cohere-embed-english
# OpenAI: text-embedding-ada-002, text-embedding-3-small
EMBEDDING_MODEL=titan-embed-text-v2

# =============================================================================
# AWS Configuration (for Bedrock)
# =============================================================================

AWS_REGION=us-east-1
# AWS credentials are handled by IAM role (Lambda) or AWS CLI (local)

# =============================================================================
# LM Studio Configuration (local development)
# =============================================================================

# LM Studio base URL (default: http://localhost:1234/v1)
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# =============================================================================
# OpenAI Configuration (legacy/optional)
# =============================================================================

# Only needed if using OpenAI backend
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxx
