# Copy this to terraform.tfvars and fill in your values

aws_region   = "eu-west-3"
environment  = "prod"
project_name = "virtual-me-chatbot"

# Bedrock models - pick one:
# llama-3.2-1b, llama-3.2-3b, llama-3.2-8b, claude-3-haiku, claude-3-sonnet, mistral-7b
llm_model       = "nova-2-lite"
llm_temperature = "0.1"

# Embeddings - titan-embed-text-v2 works well
embedding_model = "titan-embed-text-v2"

log_retention_days = 7
