###############################################################################
# Terraform Remote State Backend Configuration
#
# IMPORTANT: This file is an EXAMPLE. To use remote state:
#
# 1. Create S3 bucket and DynamoDB table manually (one-time setup):
#    aws s3 mb s3://virtualme-terraform-state-YOUR-ACCOUNT-ID --region eu-west-3
#    aws dynamodb create-table \
#      --table-name virtualme-terraform-locks \
#      --attribute-definitions AttributeName=LockID,AttributeType=S \
#      --key-schema AttributeName=LockID,KeyType=HASH \
#      --billing-mode PAY_PER_REQUEST \
#      --region eu-west-3
#
# 2. Copy this file to backend.tf:
#    cp backend.tf.example backend.tf
#
# 3. Update the bucket name with your AWS account ID
#
# 4. Run terraform init to migrate state:
#    terraform init -migrate-state
#
###############################################################################

terraform {
  backend "s3" {
    # Replace YOUR-ACCOUNT-ID with your actual AWS account ID
    bucket = "virtualme-terraform-state-YOUR-ACCOUNT-ID"
    key    = "virtualme/terraform.tfstate"
    region = "eu-west-3"

    # DynamoDB table for state locking
    dynamodb_table = "virtualme-terraform-locks"

    # Enable encryption at rest
    encrypt = true

    # Recommended: Enable versioning on the S3 bucket
    # (configure this in S3 bucket settings)
  }
}
